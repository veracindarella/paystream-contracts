# PayStream dashboard environment configuration
#
# The dashboard supports multiple Stellar networks. Select the network with
# NEXT_PUBLIC_NETWORK and provide the matching RPC URL, contract ID, and
# (optionally) network passphrase for that network.
#
# Supported networks: testnet | mainnet
#
# The app refuses to start if:
#   - NEXT_PUBLIC_NETWORK_PASSPHRASE does not match the selected network, or
#   - NEXT_PUBLIC_STREAM_CONTRACT_ID is not valid for the selected network.
#
# ---------------------------------------------------------------------------
# Testnet example
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK=testnet
# Testnet Soroban RPC endpoint
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# PayStream stream contract deployed to testnet (see scripts/deploy-testnet.sh)
NEXT_PUBLIC_STREAM_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Optional: must match the selected network if set
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---------------------------------------------------------------------------
# Mainnet example (uncomment and replace the values above to switch networks)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_NETWORK=mainnet
# Mainnet Soroban RPC endpoint
# NEXT_PUBLIC_RPC_URL=https://soroban-mainnet.stellar.org
# PayStream stream contract deployed to mainnet (see scripts/deploy-mainnet.sh)
# NEXT_PUBLIC_STREAM_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
# Optional: must match the selected network if set
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015